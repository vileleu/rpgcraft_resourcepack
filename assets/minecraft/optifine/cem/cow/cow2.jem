								}
							]
						}
					]
				}
			],
			"animations": [
				{
					"random.rx": "limb_swing+time",
					"random.ry": "sin((limb_swing+time)/32)/10",
					"wave.rz": "(1-fmod(limb_swing, 2))*2",
					"wave.ry": "cos(random.rx*pi/128)-cos(random.rx*pi/32)+1.4",
					"wave.rx": "sin(((wave.rz*2)*(116.626-fmod(random.rx,256))*pi)/22.748)",
					"tail.ry": "if(limb_speed < 0.02, if(wave.ry < 0, wave.rx/-1.5+random.ry, random.ry), random.ry)",
					"neck.rz": "-head.ry/1.3",
					"head2.rx": "sin(time/32)/96",
					"head2.rz": "sin(time/64)/128",
					"health_bar.rx": "-player_rot_x",
					"health_bar.ry": "torad(180) - rot_y + player_rot_y",
					"var.health_bar": "max(if(is_hurt, 16, var.health_bar - 1 * frame_time), 0)",
					"health_bar.visible": "var.health_bar > 0 && death_time == 0 && !is_ridden"
				}
			]
		},
