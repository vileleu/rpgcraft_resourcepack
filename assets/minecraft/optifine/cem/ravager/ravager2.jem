				{
					"rotation.rx": "0",
					"leafbody.ty": "0",
					"leafhead.ry": "head.ry",
					"leafhead.rz": "head.rz / 2",
					"leafleftarm.rx": "torad(-70) + -sin(limb_swing/1.5)*limb_speed / 2+ -(sin(pi*swing_progress*0.05))*16",
					"leafrightarm.rx": "torad(-70) + sin(limb_swing/1.5)*limb_speed / 2+ -(sin(pi*swing_progress*0.05))*16",
					"leafleftleg.rx": "torad(-37.5) + sin(limb_swing/1.5)*limb_speed/2",
					"leafrightleg.rx": "torad(-37.5) + -sin(limb_swing/1.5)*limb_speed/2",
					"bone2.rx": "torad(105) + sin(torad(13.5*3) + time/45) *0.15",
					"bone3.rx": "torad(105) + sin(torad(12.5*3) + time/42) *0.10",
					"bone4.rx": "torad(105) + sin(torad(13.5*3) + time/45) *0.15",
					"bone115.rx": "torad(105) + sin(torad(12.5*3) + time/42) *0.10",
					"var.vexed": "max(if(is_aggressive, 5, var.vexed - 1 * frame_time), 0)",
					"leafbody_rotation_vexed.visible": "var.vexed == 0",
					"leafbody_rotation_vexed_angry.visible": "var.vexed > 0",
					"leaftorso_vexed.visible": "var.vexed == 0",
					"leaftorso_vexed_angry.visible": "var.vexed > 0",
					"leafleftleg_vexed.visible": "var.vexed == 0",
					"leafleftleg_vexed_angry.visible": "var.vexed > 0",
					"leafrightleg_vexed.visible": "var.vexed == 0",
					"leafrightleg_vexed_angry.visible": "var.vexed > 0",
					"leafleftarm_vexed.visible": "var.vexed == 0",
					"leafleftarm_vexed_angry.visible": "var.vexed > 0",
					"leafrightarm_vexed.visible": "var.vexed == 0",
					"leafrightarm_vexed_angry.visible": "var.vexed > 0",
					"leafleftarm2_vexed.visible": "var.vexed == 0",
					"leafleftarm2_vexed_angry.visible": "var.vexed > 0",
					"leafrightarm2_vexed.visible": "var.vexed == 0",
					"leafrightarm2_vexed_angry.visible": "var.vexed > 0",
					"health_bar.rx": "-player_rot_x",
					"health_bar.ry": "torad(180) - rot_y + player_rot_y",
					"var.health_bar": "max(if(is_hurt, 32, var.health_bar - 1 * frame_time), 0)",
					"health_bar.visible": "var.health_bar > 0 && death_time == 0"
				}
			]
		},
