					"right_arm2.rx": "right_arm.rx",
					"head2.rx": "head.rx",
					"head2.ry": "head.ry",
					"baby_leg_rotation.rz": "torad(lerp(random(id), -45, 45))",
					"baby_leg_rotation.ry": "torad(lerp(random(id), -45, 45))",
					"baby_leg_rotation2.rz": "torad(lerp(random(id), -45, 45))",
					"baby_leg_rotation2.ry": "torad(lerp(random(id), -45, 45))",
