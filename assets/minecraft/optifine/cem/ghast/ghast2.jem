				{
					"bolt2.rz": "torad(90) + time/256",
					"bolt3.rz": "torad(90) + time/128",
					"bolt.rz": "-bolt3.rz",
					"head1.rx": "-torad(5) + sin(torad(12.5*3) + time/16) *0.05",
					"left_ear1.rz": "-torad(5) + sin(torad(12.5*3) + time/16) *0.05",
					"right_ear1.rz": "-left_ear1.rz",
					"var.burn": "if(is_in_lava, var.burn + frame_time, var.burn)",
					"piglin.visible": "var.burn == 0",
					"piglin_burning.visible": "var.burn > 0 && var.burn < 2",
					"var.hurt": "max(if(is_hurt, 512, var.hurt - 2 * frame_time), 0)",
					"passenger.visible": "var.hurt == 0",
					"upper_body_burning.rx": "-torad(5) + sin(torad(12.5*3) + time/4) *0.04",
					"cloth_burning.rx": "-upper_body_burning.rx*2.5",
					"left_arm_burning.rz": "-torad(10) + sin(torad(12.5*3) + time/1) *0.3",
					"right_arm_burning.rz": "-left_arm_burning.rz",
					"head1_burning.ry": "-torad(5) + sin(torad(12.5*3) + time/3) *0.2",
					"right_ear1_burning.rz": "-torad(-15) + sin(torad(12.5*3) + time/3) *0.1",
					"left_ear1_burning.rz": "-right_ear1_burning.rz",
					"right_leg_burning.rx": "-torad(4) + sin(torad(3*3) + time/3) *0.05",
					"left_leg_burning.rx": "-torad(4) + -sin(torad(3*3) + time/3) *0.05",
					"billboard.rx": "-player_rot_x",
					"seat.ry": "-rot_y",
					"billboard.ry": "torad(180) - rot_y + player_rot_y",
					"var.health_bar": "max(if(is_hurt, 8, var.health_bar - 1 * frame_time), 0)",
					"health_bar.visible": "var.health_bar > 0 && death_time == 0",
					"varb.alive": "is_alive",
					"body.visible": "varb.alive"
				}
			]
