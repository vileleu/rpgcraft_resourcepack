				{
					"var.scale": "1*1.6",
					"scale.sx": "var.scale",
					"scale.sy": "var.scale",
					"scale.sz": "var.scale",
					"head2.rx": "torad(33.3) + head.rx",
					"head2.ry": "head.ry",
					"left_ear2.rx": "left_ear.rx/3",
					"right_ear2.rx": "right_ear.rx/3",
					"left_ear2.rz": "left_ear.rz",
					"right_ear2.rz": "right_ear.rz",
					"left_arm2.rx": "left_arm.rx*1.6",
					"right_arm2.rx": "right_arm.rx*1.6",
					"left_thigh2.rx": "torad(22.5) + left_thigh.rx",
					"right_thigh2.rx": "torad(22.5) + right_thigh.rx",
					"left_foot2.rx": "torad(22.5) + left_thigh.rx",
					"right_foot2.rx": "torad(22.5) + right_thigh.rx",
					"inverse.rx": "-left_arm.rx",
					"health_bar.rx": "-player_rot_x",
					"health_bar.ry": "torad(180) - rot_y + player_rot_y",
					"var.health_bar": "max(if(is_hurt, 16, var.health_bar - 1 * frame_time), 0)",
					"health_bar.visible": "var.health_bar > 0 && death_time == 0 && !is_ridden"
				}
			]
