			"animations": [
				{
					"body_rotation.rx": "0",
					"left_ear_rotation.rx": "torad(if(random(id) < 0.75, lerp(random(id + 1), -5, 5), lerp(random(id + 1), -45, 45)))",
					"right_ear_rotation.rx": "torad(if(random(id) < 0.75, lerp(random(id + 2), -5, 5), lerp(random(id + 2), -45, 45)))",
					"neck.rx": "head.rx/2",
					"neck.rz": "head.rz/2",
					"head2.rx": "head.rx",
					"head2.ry": "head.ry",
					"head2.rz": "-head.rz",
					"head2x.rx": "-body.rx",
					"tail2.rx": "tail.rx",
					"tail2.ry": "tail.ry",
					"tail2.rz": "tail.rz",
					"mane2.ry": "mane.rz",
					"tail2x.rx": "-body.rx",
					"leg1_swim.rx": "if(is_in_water, sin(time/2), 0)",
					"leg2_swim.rx": "if(is_in_water, -sin(time/2), 0)",
					"leg3_swim.rx": "if(is_in_water, torad(-60)+-sin(time/2)/2, 0)",
					"leg4_swim.rx": "if(is_in_water, torad(-60)+sin(time/2)/2, 0)",
					"back_left_leg.rx": "leg1.rx",
					"back_right_leg.rx": "leg2.rx",
					"front_left_leg.rx": "leg3.rx",
					"front_right_leg.rx": "leg4.rx",
					"legs.ry": "-body.rz",
					"front_legs.rx": "torad(90)+-body.rx",
					"back_legs.rx": "torad(90)+-body.rx",
					"body1.tz": "if(is_in_water, -3, 2)",
					"var.angry": "max(if(is_aggressive, 5, var.angry - 2 * frame_time), 0)",
					"ears.visible": "var.angry == 0",
					"ears_aggressive.visible": "var.angry > 0",
					"health_bar.rx": "-player_rot_x",
					"health_bar.ry": "torad(180) - rot_y + player_rot_y",
					"var.health_bar": "max(if(is_hurt, 16, var.health_bar - 1 * frame_time), 0)",
					"health_bar.visible": "var.health_bar > 0 && death_time == 0",
					"leg1_invert.rx": "-leg1.rx"
				}
			]
