{
	"credit": "Created by Mickey Joe Alpha - http://YouTube.com/@MushirMickeyJoe / with help from FreshLX",
	"textureSize": [128, 64],
	"texture": "textures/entity/spider/relatively_improved_crab.png",
	"models": [
		{
			"part": "head",
			"id": "head",
			"invertAxis": "xy",
			"translate": [0, -9, 3],
			"animations": [
				{
					"var.eyes_forward": "clamp(if(head_pitch!=0, min(20, var.eyes_forward +0.1 *frame_time*20), max(0, var.eyes_forward -0.1 *frame_time*20)), 0, 1)",
					"var.glowing_eyes": "max(if(is_aggressive, 10, var.glowing_eyes - 1 * frame_time), 0)",
					"body_chill.visible": "var.glowing_eyes == 0",
					"body_aggro.visible": "var.glowing_eyes > 0",
					"left_eye_chill.visible": "var.glowing_eyes == 0",
					"left_eye_aggro.visible": "var.glowing_eyes > 0",
					"right_eye_chill.visible": "var.glowing_eyes == 0",
					"right_eye_aggro.visible": "var.glowing_eyes > 0"
				},
				{
					"left_arm.ry": "torad(-22.4) + limb_speed*sin(limb_swing)/5",
					"right_arm.ry": "torad(22.4) + limb_speed*sin(limb_swing)/6",
					"left_eye.rx": "( 0 )*var.eyes_forward",
					"left_eye.ry": "torad( head_yaw +( 40 )*var.eyes_forward )",
					"left_eye.rz": "( 0 )*var.eyes_forward",
					"right_eye.rx": "( 0 )*var.eyes_forward",
					"right_eye.ry": "torad( head_yaw +( 40 )*var.eyes_forward )",
					"right_eye.rz": "( 0 )*var.eyes_forward",
					"leg9.ry": "leg1.ry",
					"leg9.rx": "leg1.rx",
					"leg9.rz": "leg1.rz",
					"leg10.ry": "leg2.ry",
					"leg10.rx": "leg2.rx",
					"leg10.rz": "leg2.rz",
					"leg11.ry": "leg3.ry",
					"leg11.rx": "leg3.rx",
					"leg11.rz": "leg3.rz",
					"leg12.ry": "leg4.ry",
					"leg12.rx": "leg4.rx",
					"leg12.rz": "leg4.rz",
					"leg13.ry": "leg5.ry",
					"leg13.rx": "leg5.rx",
					"leg13.rz": "leg5.rz",
					"leg14.ry": "leg6.ry",
					"leg14.rx": "leg6.rx",
					"leg14.rz": "leg6.rz",
					"leg15.ry": "leg7.ry",
					"leg15.rx": "leg7.rx",
					"leg15.rz": "leg7.rz",
					"leg16.ry": "leg8.ry",
					"leg16.rx": "leg8.rx",
					"leg16.rz": "leg8.rz",
					"health_bar.rx": "-player_rot_x",
					"health_bar.ry": "torad(180) - rot_y + player_rot_y",
					"var.health_bar": "max(if(is_hurt, 32, var.health_bar - 1 * frame_time), 0)",
					"health_bar.visible": "var.health_bar > 0 && death_time == 0"
				}
			]
		},
