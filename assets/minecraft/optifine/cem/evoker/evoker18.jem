				{
					"brow.rz": "torad(lerp(random(id), -5.5, 5.5))",
					"head2.rx": "head.rx",
					"head2.ry": "head.ry/2",
					"arms2.rx": "arms.rx",
					"left_leg2.rx": "left_leg.rx",
					"right_leg2.rx": "right_leg.rx",
					"left_arm2.rx": "left_arm.rx*1.5",
					"right_arm2.rx": "right_arm.rx*1.5",
					"var.vexed": "max(if(right_arm.visible, 1, var.vexed - 2 * frame_time), 0)",
					"head_chill.visible": "var.vexed == 0",
					"head_casting.visible": "var.vexed > 0",
					"arms_casting.visible": "var.vexed > 0",
					"arms2.visible": "var.vexed == 0",
					"robes_casting.visible": "var.vexed > 0",
					"robes_chill.visible": "var.vexed == 0",
					"necklace.visible": "var.vexed == 0",
					"necklace_angry.visible": "var.vexed > 0",
					"health_bar.rx": "-player_rot_x",
					"health_bar.ry": "torad(180) - rot_y + player_rot_y",
					"var.health_bar": "max(if(is_hurt, 32, var.health_bar - 1 * frame_time), 0)",
					"health_bar.visible": "var.health_bar > 0 && death_time == 0"
				}
			]
		},
